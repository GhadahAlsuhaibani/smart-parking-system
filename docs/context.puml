@startuml context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Smart Parking Management System - System Context (C4 Level 1)

Person(driver, "Driver", "Searches for available parking spaces and reserves parking")
Person(admin, "Parking Administrator", "Manages parking facilities, spaces, and pricing")
Person(staff, "Parking Staff", "Monitors parking occupancy and validates vehicle entry and exit")
Person(sensors, "Parking Sensors / IoT System", "Reports real-time parking space occupancy")

System(sps, "Smart Parking System", "Helps drivers find, reserve, and manage parking spaces while enabling parking operators to monitor facilities.")

System_Ext(payment, "Payment Gateway", "Processes parking payments and refunds")
System_Ext(notify, "Notification Provider", "Sends reservation confirmations and reminders through SMS or email")
System_Ext(maps, "Mapping Service", "Provides maps, location information, and navigation")

Rel(driver, sps, "Searches for spaces, makes reservations, and pays")
Rel(admin, sps, "Manages parking facilities, spaces, and pricing")
Rel(staff, sps, "Monitors occupancy and validates vehicle entry and exit")
Rel(sensors, sps, "Sends parking occupancy updates", "MQTT / HTTP")

Rel(sps, payment, "Processes payments and refunds", "HTTPS / REST")
Rel(sps, notify, "Sends booking confirmations and reminders", "HTTPS / REST")
Rel(sps, maps, "Retrieves location and navigation data", "HTTPS / REST")

SHOW_LEGEND()
@enduml
